#include <winres.h>

1 ICON "spidy.ico"

// Spidy's print, the house style of its videos and README (main.cpp loads them; SIL Open Font License,
// docs/licenses).
FONT_BODY RCDATA "fonts/Barlow-Medium.ttf"
FONT_SEMIBOLD RCDATA "fonts/Barlow-SemiBold.ttf"
FONT_LABEL RCDATA "fonts/BarlowCondensed-Bold.ttf"
FONT_KICKER RCDATA "fonts/BarlowCondensed-SemiBold.ttf"
FONT_DISPLAY RCDATA "fonts/BarlowCondensed-BlackItalic.ttf"
FONT_NARRATION RCDATA "fonts/ComicNeue-BoldItalic.ttf"

// The controls on Quest 3 controllers, the moves, the phone and the other controllers' buttons: the README's
// pictures (the Controls tab).
PICTURE_CONTROLS RCDATA "../../docs/images/readme/controls-quest3.jpg"
PICTURE_MOVES RCDATA "../../docs/images/readme/controls-moves.jpg"
PICTURE_PHONE RCDATA "../../docs/images/readme/controls-phone.jpg"
PICTURE_OTHERS RCDATA "../../docs/images/readme/controls-others.jpg"

// The version resource keeps the plain numbers (the release check compares them); SPIDY_VERSION may carry a
// label such as -na-beta1 for the launcher and the log.
#ifndef SPIDY_FILE_VERSION
#define SPIDY_FILE_VERSION "0.0.0"
#endif
VS_VERSION_INFO VERSIONINFO
FILEVERSION SPIDY_VERSION_NUMBERS
PRODUCTVERSION SPIDY_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ilya Mezerowsky"
            VALUE "FileDescription", "Spidy VR launcher"
            VALUE "FileVersion", SPIDY_FILE_VERSION
            VALUE "InternalName", "spidy_launcher"
            VALUE "LegalCopyright", "Copyright 2026 Ilya Mezerowsky"
            VALUE "OriginalFilename", "Spidy Launcher.exe"
            VALUE "ProductName", "Spidy - VR for Marvel's Spider-Man Remastered"
            VALUE "ProductVersion", SPIDY_FILE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
